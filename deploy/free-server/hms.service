[Unit]
Description=MGM HMS (hospital information system)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/mgm-hms
Environment=NODE_ENV=production
Environment=HMS_ENV=demo
Environment=HMS_TRUST_PROXY=1
Environment=PORT=4300
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
